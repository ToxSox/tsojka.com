---
import { Image } from 'astro:assets';
import thomas from '../assets/hero/thomas.png';
---

<!--
  Akt 1 · Begegnung. pin + Ebenen über --sc-p + Pointer-EQ (BRIEF.md §8/§9).
  Ebenen von hinten nach vorn: Licht, Messraster, Headline, Thomas, Ergebniskurve, Boden.
-->
<section id="top" class="hero ground ground--black" data-sc-act="pin" data-sc-span="1.6" data-hero>
  <div data-sc-stage class="hero-stage">
    <div class="hero-light" aria-hidden="true"></div>
    <canvas class="hero-back" data-eq-back aria-hidden="true"></canvas>

    <div class="hero-copy sc-wrap">
      <p class="hero-kicker">Willkommen auf der Seite zu meinem Car-HiFi-Kanal</p>
      <h1 class="hero-title">Werksklang raus.<br /><span class="accent">Konzerthalle rein.</span></h1>
      <p class="hero-sub">
        Entdecke hochwertige Tutorials, ehrliche Audio-Reviews und smarte Einbautipps. Dein Hub für DSP-Tuning und
        Fachwissen.
      </p>
      <div class="hero-actions">
        <a class="pill" href="#videos" data-sc-magnet="0.24">Videos ansehen</a>
        <a class="more" href="#labor">Zum Testlabor</a>
      </div>
    </div>

    <div class="hero-subject">
      <Image
        src={thomas}
        alt="Thomas Sojka"
        widths={[480, 797]}
        sizes="(max-width: 860px) 96vw, 52vw"
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <canvas class="hero-front" data-eq-front aria-hidden="true"></canvas>
    <div class="hero-floor" aria-hidden="true"></div>

    <div class="readout" aria-live="off">
      <p class="readout-head"><i aria-hidden="true"></i>EQ · Band 1 · <span data-ro-hint>Maus bewegen</span></p>
      <p class="readout-vals">
        <span>f <b data-ro-f>1,00 kHz</b></span>
        <span>G <b data-ro-g>+0,0 dB</b></span>
        <span>Q <b>1,41</b></span>
      </p>
    </div>
  </div>
</section>

<style>
  .hero-stage {
    isolation: isolate;
    touch-action: pan-y;
  }

  .hero-light,
  .hero-back,
  .hero-front,
  .hero-floor {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero-light {
    z-index: 0;
    background: radial-gradient(42% 46% at 50% 78%, rgba(255, 90, 31, 0.13), transparent 70%);
  }

  .hero-back {
    z-index: 1;
    max-width: none;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: var(--sc-4);
    padding-top: clamp(3rem, 7.5vh, 6rem);
    text-align: center;
    pointer-events: none;
  }

  .hero-copy > * {
    pointer-events: auto;
  }

  .hero-kicker {
    margin: 0;
    color: var(--sc-ink-soft);
    font-size: var(--sc-t-base);
    font-weight: 500;
  }

  .hero-title {
    margin: 0;
    font-size: clamp(2.6rem, 1.2rem + 4.4vw, 5.2rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .hero-sub {
    margin: 0;
    max-width: 44rem;
    color: var(--sc-ink-soft);
    font-size: var(--sc-t-lg);
    line-height: 1.4;
    text-wrap: balance;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--sc-5);
    margin-top: var(--sc-2);
  }

  .hero-subject {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 0;
    width: min(44vw, 48vh);
    translate: -50% 0;
    transform-origin: 50% 100%;
    pointer-events: none;
  }

  .hero-subject :global(img) {
    width: 100%;
    height: auto;
    max-width: none;
  }

  .hero-front {
    z-index: 4;
    max-width: none;
  }

  /* Boden-Verlauf über allen Ebenen: versteckt den geraden Schnitt unten am Foto */
  .hero-floor {
    z-index: 5;
    background: linear-gradient(to top, var(--sc-canvas) 0%, color-mix(in oklab, var(--sc-canvas) 70%, transparent) 9%, transparent 26%);
  }

  .readout {
    position: absolute;
    z-index: 6;
    left: var(--sc-gutter);
    bottom: clamp(1.5rem, 5vh, 3rem);
    display: grid;
    gap: 0.3rem;
    margin: 0;
    color: var(--sc-ink-soft);
    font-family: var(--sc-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
  }

  .readout p {
    margin: 0;
  }

  .readout-head {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .readout-head i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--led-live);
  }

  .readout-head span {
    color: var(--sc-accent);
  }

  .readout-vals {
    display: flex;
    gap: 1rem;
  }

  .readout b {
    color: var(--sc-ink);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  /* Tiefe aus unterschiedlichen Raten. Kopie auf 1x-nahe Bahn, Kurve am stärksten. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-back {
      transform: translate3d(0, calc(var(--sc-p, 0) * -3vh), 0) scale(calc(1 + var(--sc-p, 0) * 0.05));
    }

    .hero-copy {
      transform: translate3d(0, calc(var(--sc-p, 0) * -9vh), 0) scale(calc(1 - var(--sc-p, 0) * 0.06));
      opacity: calc(1 - var(--sc-p, 0) * 1.25);
    }

    /* Unten verankert: Thomas kommt näher, die Schnittkante bleibt hinter dem Boden */
    .hero-subject {
      transform: scale(calc(1 + var(--sc-p, 0) * 0.14));
    }

    .hero-front {
      transform: translate3d(0, calc(var(--sc-p, 0) * -24vh), 0);
    }
  }

  /* Ohne Bewegung kein Pin-Raum: der Hero ist dann genau ein Bildschirm hoch.
     Die Engine setzt die Höhe inline, daher !important. */
  @media (prefers-reduced-motion: reduce) {
    .hero {
      height: 100vh !important;
      height: 100svh !important;
    }
  }

  @media (max-width: 860px) {
    .hero-copy {
      padding-top: clamp(2.5rem, 7vh, 4rem);
      gap: var(--sc-3);
    }

    .hero-title {
      font-size: clamp(2rem, 1rem + 6vw, 3rem);
    }

    .hero-sub {
      font-size: var(--sc-t-base);
    }

    .hero-subject {
      width: min(100vw, 50svh);
    }

    .readout {
      left: auto;
      right: var(--sc-gutter);
      bottom: 1rem;
      text-align: right;
    }

    .readout-head,
    .readout-vals {
      justify-content: flex-end;
    }
  }

  @media (max-width: 380px), (max-height: 640px) {
    .hero-kicker {
      display: none;
    }
  }
</style>

<script>
  import { initEq } from '../scripts/eq';
  initEq();
</script>
