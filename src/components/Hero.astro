---

const lines = [
  { text: 'Werksklang', accent: false },
  { text: 'raus.', accent: true },
  { text: 'Konzerthalle', accent: false },
  { text: 'rein.', accent: true },
];
---

<section class="hero" data-hero>
  <canvas class="hero-canvas" data-eq aria-hidden="true"></canvas>
  <div class="hero-vignette" aria-hidden="true"></div>

  <div class="wrap hero-inner">
    <p class="mono hero-kicker" data-hero-in style="--d:0">
      <span class="signal">CH.00</span> — Willkommen auf der Seite zu meinem Car-HiFi-Kanal
    </p>

    <h1 class="hero-title" aria-label="Werksklang raus. Konzerthalle rein.">
      <span class="hero-row" aria-hidden="true">
        {lines.slice(0, 2).map((l, i) => (
          <span class="split-line" data-hero-in>
            <span class:list={[l.accent && 'signal']} style={`--i:${i}`}>{l.text}</span>
          </span>
        ))}
      </span>
      <span class="hero-row" aria-hidden="true">
        {lines.slice(2).map((l, i) => (
          <span class="split-line" data-hero-in>
            <span class:list={[l.accent && 'signal']} style={`--i:${i + 2}`}>{l.text}</span>
          </span>
        ))}
      </span>
    </h1>

    <div class="hero-bottom">
      <p class="hero-sub" data-hero-in style="--d:5">
        Entdecke hochwertige Tutorials, ehrliche Audio-Reviews und smarte Einbautipps aus der Community, für die Community.
        Dein Hub für <strong>DSP-Tuning</strong> und Fachwissen.
      </p>
      <div class="hero-actions" data-hero-in style="--d:6">
        <a class="btn btn--solid" href="#videos" data-magnetic>Videos <span class="arrow">→</span></a>
        <a class="btn" href="#labor" data-magnetic>Testlabor</a>
        <a class="btn" href="#workshops" data-magnetic>Workshops</a>
      </div>
    </div>
  </div>

  <div class="readout mono" data-hero-in style="--d:7" aria-hidden="true">
    <span class="readout-title"><i></i>PEQ · Band 1 · <span class="readout-hint">Maus bewegen</span></span>
    <span>f <b data-ro-f>1.00 kHz</b></span>
    <span>G <b data-ro-g>+0.0 dB</b></span>
    <span>Q <b>1.41</b></span>
  </div>

  <a class="scroll-cue mono" href="#intro" aria-label="Weiter scrollen" data-hero-in style="--d:8">
    <span>Scroll</span><i></i>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-block: 8rem clamp(5.5rem, 10vh, 7rem);
    overflow: hidden;
    isolation: isolate;
  }

  .hero-canvas {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }

  .hero-vignette {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 80% 60% at 70% 40%, transparent 0%, rgba(9, 9, 10, 0.4) 60%, var(--bg) 100%),
      linear-gradient(to top, var(--bg) 0%, transparent 45%);
  }

  .hero-inner {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    pointer-events: none;
  }

  .hero-inner a,
  .hero-inner p {
    pointer-events: auto;
  }

  .hero-kicker {
    color: var(--muted);
  }

  .hero-title {
    display: grid;
    font-size: clamp(3.2rem, 11.5vw, 11rem);
    font-weight: 800;
    font-stretch: 75%;
    text-transform: uppercase;
    line-height: 0.82;
    letter-spacing: -0.035em;
  }

  .hero-row {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.22em;
  }

  .hero-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .hero-sub {
    max-width: 34rem;
    color: var(--muted);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.2rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .readout {
    position: absolute;
    top: 7rem;
    right: var(--gutter);
    display: grid;
    gap: 0.35rem;
    min-width: 13rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(12, 12, 13, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--muted);
    font-size: 0.68rem;
  }

  .readout b {
    color: var(--text);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .readout-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.4rem;
    margin-bottom: 0.2rem;
    border-bottom: 1px solid var(--line);
  }

  .readout-title i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--led-live);
    box-shadow: 0 0 8px var(--led-live);
  }

  .readout-hint {
    color: var(--signal);
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    color: var(--dim);
    font-size: 0.6rem;
    text-decoration: none;
    transform: translateX(-50%);
  }

  .scroll-cue i {
    position: relative;
    width: 1px;
    height: 2.5rem;
    background: var(--line-2);
    overflow: hidden;
  }

  .scroll-cue i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--signal);
    animation: cue 2s var(--ease-in-out) infinite;
  }

  @keyframes cue {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(100%); }
  }

  /* Einblenden nach dem Boot */
  [data-hero-in]:not(.split-line) {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 1s var(--ease-out),
      transform 1s var(--ease-out);
    transition-delay: calc(var(--d, 0) * 100ms);
  }

  .hero.is-in [data-hero-in]:not(.split-line) {
    opacity: 1;
    transform: none;
  }

  .scroll-cue[data-hero-in] {
    transform: translate(-50%, 20px);
  }

  .hero.is-in .scroll-cue[data-hero-in] {
    transform: translateX(-50%);
  }

  :global(.no-js) [data-hero-in] {
    opacity: 1 !important;
    transform: none !important;
  }

  @media (max-width: 760px) {
    .readout {
      top: auto;
      bottom: auto;
      right: auto;
      left: var(--gutter);
      top: 5.75rem;
      min-width: 0;
      grid-template-columns: repeat(3, auto);
      column-gap: 1rem;
    }

    .readout-title {
      grid-column: 1 / -1;
    }

    .scroll-cue {
      display: none;
    }
  }

  @media (max-height: 640px) and (max-width: 760px) {
    .readout {
      display: none;
    }
  }
</style>

<script>
  import { initEq } from '../scripts/eq';
  initEq();
</script>
