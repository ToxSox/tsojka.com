---
import { chapters } from '../data/site';
---

<header class="nav" data-nav-bar>
  <div class="nav-inner sc-wrap">
    <a href="/" class="nav-mark" aria-label="TSojka Audio, zur Startseite">
      <img src="/tsa.svg" alt="" width="96" height="34" />
    </a>

    <nav class="nav-links" aria-label="Kapitel">
      {chapters.map((c) => <a href={`/#${c.id}`} data-nav={c.id}>{c.label}</a>)}
    </nav>

    <a class="pill nav-cta" href="/#kontakt" data-nav="kontakt">Kontakt</a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu" data-menu-btn>
      <span class="sr-only" data-menu-label>Menü öffnen</span>
      <span class="nav-toggle-bars" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>

  <div class="nav-menu" id="nav-menu" data-menu hidden>
    <nav class="sc-wrap" aria-label="Kapitel (mobil)">
      {chapters.map((c) => <a href={`/#${c.id}`}>{c.label}</a>)}
      <a href="/videos">Alle Videos</a>
      <a href="/#kontakt">Kontakt</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--sc-z-chrome);
    background: rgba(10, 10, 11, 0.72);
    backdrop-filter: saturate(180%) blur(18px);
    -webkit-backdrop-filter: saturate(180%) blur(18px);
    border-bottom: 1px solid rgba(245, 245, 247, 0.08);
    color: #f5f5f7;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: var(--sc-6);
    height: var(--nav-h);
  }

  .nav-mark img {
    width: auto;
    height: 1.55rem;
    filter: brightness(0) invert(0.96);
  }

  .nav-links {
    display: flex;
    gap: var(--sc-5);
    margin-left: auto;
  }

  .nav-links a {
    color: rgba(245, 245, 247, 0.72);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color var(--sc-d-fast) var(--sc-ease-out);
  }

  .nav-links a:hover,
  .nav-links a.is-active {
    color: #f5f5f7;
  }

  .nav-cta {
    min-height: 2rem;
    padding: 0.3rem 0.95rem;
    font-size: 0.875rem;
    --sc-accent: #ff5a1f;
    --sc-accent-ink: #0a0a0b;
  }

  .nav-toggle {
    display: none;
    position: relative;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.6rem;
    border: 0;
    background: transparent;
    color: #f5f5f7;
    cursor: pointer;
  }

  .nav-toggle-bars i {
    position: absolute;
    left: 50%;
    width: 1.1rem;
    height: 1.5px;
    margin-left: -0.55rem;
    background: currentColor;
    transition: transform var(--sc-d-base) var(--sc-ease-out);
  }

  .nav-toggle-bars i:first-child { top: calc(50% - 4px); }
  .nav-toggle-bars i:last-child { top: calc(50% + 3px); }

  .nav-toggle[aria-expanded='true'] .nav-toggle-bars i:first-child { transform: translateY(3.5px) rotate(45deg); }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bars i:last-child { transform: translateY(-3.5px) rotate(-45deg); }

  .nav-menu {
    border-top: 1px solid rgba(245, 245, 247, 0.08);
  }

  .nav-menu nav {
    display: grid;
    padding-block: var(--sc-3) var(--sc-6);
  }

  .nav-menu a {
    padding-block: 0.7rem;
    border-bottom: 1px solid rgba(245, 245, 247, 0.08);
    color: #f5f5f7;
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .nav-menu:not([hidden]) {
    animation: menu-in 0.24s var(--sc-ease-out);
  }

  @keyframes menu-in {
    from { opacity: 0; transform: translateY(-6px); }
  }

  @media (max-width: 860px) {
    .nav-links { display: none; }
    .nav-cta { margin-left: auto; }
    .nav-toggle { display: block; }
  }
</style>
