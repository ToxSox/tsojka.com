---
import { apps } from '../data/site';
---

<!-- Akt 7 · Spielraum. pan: seitlich liest sich als Auswahl, nicht als Rangfolge. -->
<section id="apps" class="ground ground--black apps" data-sc-act="pan" data-sc-span="3.2">
  <div data-sc-stage class="apps-stage">
    <div class="apps-rail" data-sc-pan="0.04">
      <div class="apps-lead">
        <h2 class="statement">Apps und <em>Tools.</em></h2>
        <p class="lead"><strong>Software aus eigener Entwicklung, vom Car-Audio-Werkzeug bis zur Alltags-App.</strong></p>
        <p class="body">
          Neben Car-HiFi und 3D-Druck ist die Software-Entwicklung eine weitere Leidenschaft von mir. Hier findest du die Apps
          und Web-Tools, die von mir umgesetzt wurden und werden. Alle Projekte entstehen mit viel Liebe zum Detail und werden
          stetig weiterentwickelt.
        </p>
      </div>

      {
        apps.map((a) => (
          <article class:list={['app', `app--${a.status}`]}>
            <header class="app-head">
              <h3 class="title">{a.name}</h3>
              <p class="app-meta">
                <span class="led" aria-hidden="true" />
                <span>{a.status === 'live' ? 'Verfügbar' : 'In Entwicklung'}</span>
                <span class="app-tags">{a.tags.join(' · ')}</span>
              </p>
            </header>
            <p class="app-text">{a.text}</p>
            {a.url ? (
              <a class="more" href={a.url} target="_blank" rel="noopener noreferrer" data-cursor-text="Öffnen">
                {a.cta}
              </a>
            ) : (
              <p class="app-later">Noch nicht öffentlich verfügbar</p>
            )}
          </article>
        ))
      }

      <div class="apps-end">
        <h3 class="headline">Feedback oder Ideen zu einer App?</h3>
        <p class="body">Schreib mir einfach über den Kontaktbereich. Ich freue mich über jede Rückmeldung und jeden Feature-Wunsch.</p>
        <a class="pill" href="#kontaktformular" data-topic="App-Feedback">Feedback geben</a>
      </div>
    </div>
  </div>
</section>

<style>
  .apps-stage {
    display: flex;
    align-items: center;
    padding-top: var(--nav-h);
  }

  .apps-rail {
    gap: var(--sc-5);
    align-items: stretch;
    padding-inline: var(--sc-gutter);
  }

  .apps-lead,
  .apps-end {
    flex: 0 0 auto;
    display: grid;
    align-content: center;
    gap: var(--sc-4);
    width: min(30rem, 82vw);
    padding-right: var(--sc-6);
  }

  .apps-end {
    width: min(24rem, 82vw);
    padding-left: var(--sc-6);
    padding-right: 0;
    justify-items: start;
  }

  .app {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--sc-4);
    width: min(22rem, 78vw);
    min-height: min(30rem, 66vh);
    padding: var(--sc-6);
    border-radius: var(--sc-r-lg);
    background: var(--sc-surface);
    box-shadow: var(--sc-edge), var(--sc-e2);
  }

  .app-head {
    display: grid;
    gap: var(--sc-2);
  }

  .app-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.6rem;
    margin: 0;
    color: var(--sc-ink-soft);
    font-size: var(--sc-t-xs);
  }

  .led {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--led-live);
  }

  .app--dev .led {
    background: var(--led-dev);
  }

  .app-tags {
    font-family: var(--sc-font-mono);
  }

  .app-text {
    margin: 0;
    color: var(--sc-ink-soft);
    font-size: var(--sc-t-sm);
    line-height: 1.6;
  }

  .app .more,
  .app-later {
    margin-top: auto;
  }

  .app-later {
    margin-bottom: 0;
    color: var(--sc-ink-soft);
    font-size: var(--sc-t-sm);
  }

  @media (max-width: 860px) {
    .app {
      min-height: 0;
      padding: var(--sc-5);
    }
  }

  @media (max-height: 700px) {
    .app-text {
      font-size: var(--sc-t-xs);
    }
  }
</style>
