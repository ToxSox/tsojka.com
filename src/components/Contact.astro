---
import { intro, site } from '../data/site';

// Werte müssen zu den data-topic-Buttons der Kapitel passen (CLAUDE.md)
const topics = [
  { value: 'Kooperation', hint: 'Geschäftliche Zusammenarbeit' },
  { value: 'Testanfrage', hint: 'Deine Elektronik im Labor' },
  { value: 'Workshop', hint: 'Training für dich oder dein Team' },
  { value: 'Videoidee', hint: 'Ein Thema für den Kanal' },
  { value: 'App-Feedback', hint: 'Rückmeldung zu einer App' },
];
---

<!-- Akt 8 · Entschluss. Das Ende ist ein Eingabefeld und bleibt stehen. -->
<section id="kontakt" class="ground ground--white contact">
  <div class="sc-wrap">
    <header class="chapter-open" data-sc-in data-sc-stagger="70">
      <h2 class="statement">Lass uns <em>reden.</em></h2>
      <p class="lead"><strong>Das Ziel?</strong> {intro.goal}</p>
      <p class="body">
        Dein direkter Draht für Car-HiFi Kooperationen, Hardware-Testanfragen oder neue Videoideen. Egal, ob du eine spannende
        geschäftliche Zusammenarbeit planst, einen bestimmten Verstärker in meinem Labor durchmessen lassen möchtest oder einfach
        eine geniale Idee für mein nächstes YouTube-Tutorial hast: Nutze das Kontaktformular oder schreib mir direkt eine E-Mail.
      </p>
    </header>

    <form class="form" id="kontaktformular" action={site.formAction} method="POST" data-form>
      <fieldset class="topics">
        <legend class="title">Worum geht's?</legend>
        <div class="topic-grid">
          {
            topics.map((t, i) => (
              <label class="topic">
                <input type="radio" name="thema" value={t.value} checked={i === 0} />
                <span class="topic-tile">
                  <span class="topic-name">{t.value}</span>
                  <span class="topic-hint">{t.hint}</span>
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="fields">
        <div class="field">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="email">E-Mail</label>
          <input type="email" id="email" name="_replyto" required autocomplete="email" />
        </div>
        <div class="field field--wide">
          <label for="subject">Betreff</label>
          <input type="text" id="subject" name="subject" required />
        </div>
        <div class="field field--wide">
          <label for="message">Nachricht</label>
          <textarea id="message" name="message" rows="6" required></textarea>
        </div>
      </div>

      <p class="privacy-note">
        Deine Angaben werden über den Dienst Formspree an mich übermittelt und nur zur Beantwortung deiner Anfrage genutzt.
        Mehr dazu in der <a href="/datenschutz">Datenschutzerklärung</a>.
      </p>

      <div class="form-actions">
        <button class="pill send" type="submit"><span data-send-label>Nachricht senden</span></button>
        <span class="form-state" data-form-state aria-live="polite"></span>
      </div>

      <div class="sent" data-sent aria-live="polite">
        <svg viewBox="0 0 120 40" aria-hidden="true"><path d="M2 20 h20 l6 -14 l8 28 l8 -28 l8 28 l6 -14 h60" /></svg>
        <p class="headline">Nachricht ist raus.</p>
        <p class="body">Danke! Ich melde mich, sobald ich Zeit finde.</p>
      </div>
    </form>

    <div class="contact-foot">
      <div>
        <p class="label">E-Mail</p>
        <a class="mail" href={`mailto:${site.email}`} data-cursor-text="Mail">{site.email}</a>
      </div>
      <p class="notice">
        <strong>Wichtiger Hinweis</strong>
        <span>
          Ich bin nicht telefonisch erreichbar und biete keinen Verkauf von Komponenten, keinen Einbauservice und keine
          individuelle technische Beratung an. Bitte wende dich mit solchen Anfragen direkt an einen Händler oder eine
          Fachwerkstatt.
        </span>
      </p>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-bottom: var(--sc-section);
  }

  .contact .chapter-open > * {
    max-width: 46rem;
  }

  .form {
    position: relative;
    display: grid;
    gap: var(--sc-6);
  }

  .topics {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .topics legend {
    margin-bottom: var(--sc-4);
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--sc-3);
  }

  .topic {
    position: relative;
    cursor: pointer;
  }

  .topic input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .topic-tile {
    display: grid;
    gap: var(--sc-2);
    height: 100%;
    padding: var(--sc-5) var(--sc-4);
    border-radius: var(--sc-r-md);
    background: var(--sc-surface);
    box-shadow: inset 0 0 0 1px var(--sc-hairline);
    transition:
      box-shadow var(--sc-d-fast) var(--sc-ease-out),
      background-color var(--sc-d-fast) var(--sc-ease-out);
  }

  .topic-name {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .topic-hint {
    color: var(--sc-ink-soft);
    font-size: var(--sc-t-sm);
    line-height: 1.35;
  }

  @media (hover: hover) and (pointer: fine) {
    .topic:hover .topic-tile {
      box-shadow: inset 0 0 0 1px var(--sc-hairline-strong);
    }
  }

  .topic input:checked + .topic-tile {
    background: var(--sc-canvas);
    box-shadow: inset 0 0 0 2px var(--sc-accent);
  }

  .topic input:focus-visible + .topic-tile {
    outline: 2px solid var(--sc-accent);
    outline-offset: 3px;
  }

  .topic-tile.is-flash {
    animation: tile-flash 1.4s var(--sc-ease-out) 0.6s;
  }

  @keyframes tile-flash {
    0%, 100% { transform: none; }
    25% { transform: scale(1.03); }
  }

  .fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sc-5);
  }

  .field {
    display: grid;
    gap: var(--sc-2);
  }

  .field--wide {
    grid-column: 1 / -1;
  }

  .field label {
    font-size: var(--sc-t-sm);
    font-weight: 500;
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 0.8rem 1rem;
    border: 0;
    border-radius: var(--sc-r-md);
    background: var(--sc-surface);
    box-shadow: inset 0 0 0 1px var(--sc-hairline-strong);
    color: var(--sc-ink);
    font: inherit;
    resize: vertical;
    transition: box-shadow var(--sc-d-fast) var(--sc-ease-out);
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--sc-accent);
  }

  .privacy-note {
    margin: 0;
    max-width: 46rem;
    color: var(--sc-ink-soft);
    font-size: var(--sc-t-sm);
  }

  .privacy-note a {
    color: var(--sc-ink);
  }

  .form-actions {
    display: flex;
    align-items: center;
    gap: var(--sc-4);
  }

  .form-state {
    color: var(--sc-ink-soft);
    font-size: var(--sc-t-sm);
  }

  .sent {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--sc-4);
    border-radius: var(--sc-r-lg);
    background: var(--sc-canvas);
    text-align: center;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.4s var(--sc-ease-out),
      visibility 0s 0.4s;
  }

  .form.is-sent .sent {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.4s var(--sc-ease-out);
  }

  .sent svg {
    width: 9rem;
    fill: none;
    stroke: var(--sc-accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 220;
    stroke-dashoffset: 220;
  }

  .form.is-sent .sent svg {
    animation: draw 1.2s var(--sc-ease-out) 0.15s forwards;
  }

  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }

  .contact-foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: var(--sc-6) var(--sc-9);
    align-items: start;
    margin-top: var(--sc-9);
  }

  .mail {
    display: inline-block;
    margin-top: var(--sc-2);
    color: var(--sc-ink);
    font-size: var(--sc-t-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .mail:hover {
    color: var(--sc-accent);
    text-decoration: underline;
  }

  .contact-foot .notice {
    padding-top: 0;
    border-top: 0;
  }

  @media (max-width: 960px) {
    .topic-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .fields,
    .contact-foot {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .topic-tile.is-flash {
      animation: none;
    }
  }
</style>

<script>
  import { site } from '../data/site';

  const form = document.querySelector<HTMLFormElement>('[data-form]');
  const state = document.querySelector<HTMLElement>('[data-form-state]');
  const label = document.querySelector<HTMLElement>('[data-send-label]');

  // Buttons wie „Test anfragen“ wählen das passende Thema vor
  document.addEventListener('click', (e) => {
    const trigger = (e.target as Element).closest<HTMLElement>('[data-topic]');
    const topic = trigger?.dataset.topic;
    if (!form || !topic) return;
    const radio = form.querySelector<HTMLInputElement>(`input[name="thema"][value="${topic}"]`);
    if (!radio) return;
    radio.checked = true;
    const tile = radio.nextElementSibling;
    tile?.classList.remove('is-flash');
    void (tile as HTMLElement | null)?.offsetWidth;
    tile?.classList.add('is-flash');
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    // Thema in den Betreff übernehmen, damit es im Postfach sichtbar ist
    const thema = data.get('thema');
    if (thema) data.set('subject', `[${thema}] ${data.get('subject') ?? ''}`);

    form.classList.add('is-sending');
    if (state) state.textContent = 'Sende …';
    if (label) label.textContent = 'Wird gesendet …';

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(String(res.status));
      form.classList.remove('is-sending');
      form.classList.add('is-sent');
      if (state) state.textContent = 'Gesendet';
      form.reset();
    } catch {
      form.classList.remove('is-sending');
      if (state) state.textContent = 'Fehler beim Senden';
      if (label) label.textContent = 'Erneut versuchen';
      alert(`Das hat leider nicht geklappt. Schreib mir gern direkt an ${site.email}.`);
    }
  });
</script>
