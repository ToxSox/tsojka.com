---
import ChapterHead from './ChapterHead.astro';
import { site } from '../data/site';

const topics = ['Kooperation', 'Testanfrage', 'Workshop', 'Videoidee', 'App-Feedback'];
---

<section class="chapter contact" id="kontakt">
  <div class="wrap">
    <ChapterHead ch="06" label="Kontakt" lines={['Lass uns', '*reden*.']}>
      <p>
        Dein direkter Draht für <strong>Car-HiFi Kooperationen, Hardware-Testanfragen oder neue Videoideen</strong>. Egal, ob du
        eine spannende geschäftliche Zusammenarbeit planst, einen bestimmten Verstärker in meinem Labor durchmessen lassen
        möchtest oder einfach eine geniale Idee für mein nächstes YouTube-Tutorial hast – nutze das Kontaktformular oder
        schreib mir direkt eine E-Mail.
      </p>
    </ChapterHead>

    <div class="contact-grid">
      <aside class="contact-side">
        <p class="mono muted" data-reveal>E-Mail-Adresse</p>
        <a class="mail" href={`mailto:${site.email}`} data-reveal>
          {site.email}
        </a>

        <div class="notice" data-reveal>
          <span class="mono">Wichtiger Hinweis</span>
          <span>
            Ich bin nicht telefonisch erreichbar und biete keinen Verkauf von Komponenten, keinen Einbauservice und keine
            individuelle technische Beratung an. Bitte wende dich mit solchen Anfragen direkt an einen Händler oder eine
            Fachwerkstatt.
          </span>
        </div>
      </aside>

      <form class="form" action={site.formAction} method="POST" data-form data-reveal="scale">
        <div class="form-head mono">
          <span><i class="led"></i> Kontaktformular</span>
          <span data-form-state>Bereit</span>
        </div>

        <fieldset class="topics">
          <legend class="mono">Worum geht's?</legend>
          {
            topics.map((t, i) => (
              <label>
                <input type="radio" name="thema" value={t} checked={i === 0} />
                <span>{t}</span>
              </label>
            ))
          }
        </fieldset>

        <div class="field">
          <input type="text" id="name" name="name" required placeholder=" " autocomplete="name" />
          <label for="name">Name</label>
        </div>
        <div class="field">
          <input type="email" id="email" name="_replyto" required placeholder=" " autocomplete="email" />
          <label for="email">E-Mail</label>
        </div>
        <div class="field">
          <input type="text" id="subject" name="subject" required placeholder=" " />
          <label for="subject">Betreff</label>
        </div>
        <div class="field">
          <textarea id="message" name="message" rows="5" required placeholder=" "></textarea>
          <label for="message">Nachricht</label>
        </div>

        <button class="btn btn--solid send" type="submit">
          <span data-send-label>Nachricht senden</span> <span class="arrow">→</span>
        </button>

        <div class="sent" data-sent aria-live="polite">
          <svg viewBox="0 0 120 40" aria-hidden="true"><path d="M2 20 h20 l6 -14 l8 28 l8 -28 l8 28 l6 -14 h60" /></svg>
          <p class="sent-title">Nachricht ist raus.</p>
          <p class="muted">Danke! Ich melde mich, sobald ich Zeit finde.</p>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .contact-side {
    display: grid;
    gap: 1rem;
  }

  .mail {
    font-size: clamp(1.6rem, 3.6vw, 3.2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    text-decoration: none;
    overflow-wrap: anywhere;
    background: linear-gradient(var(--signal), var(--signal)) 0 100% / 0% 2px no-repeat;
    transition:
      background-size 0.6s var(--ease-out),
      color 0.3s;
    padding-bottom: 0.2rem;
    justify-self: start;
  }

  .mail:hover {
    color: var(--signal);
    background-size: 100% 2px;
  }

  .contact-side .notice {
    margin-top: 2rem;
  }

  .form {
    position: relative;
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border: 1px solid var(--line-2);
    border-radius: 24px;
    background: var(--bg-2);
    overflow: hidden;
  }

  .form-head {
    display: flex;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.65rem;
  }

  .form-head .led {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 0.4rem;
    border-radius: 50%;
    background: var(--led-live);
    box-shadow: 0 0 8px var(--led-live);
  }

  .form.is-sending .form-head .led {
    background: var(--led-dev);
    box-shadow: 0 0 8px var(--led-dev);
    animation: blink 0.3s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .topics legend {
    margin-bottom: 0.75rem;
    color: var(--muted);
    font-size: 0.65rem;
  }

  .topics label {
    position: relative;
    cursor: pointer;
  }

  .topics input {
    position: absolute;
    opacity: 0;
  }

  .topics span {
    display: inline-block;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    font-size: 0.9rem;
    transition:
      background 0.3s,
      color 0.3s,
      border-color 0.3s;
  }

  .topics label:hover span {
    border-color: var(--signal);
  }

  .topics input:checked + span {
    background: var(--signal);
    border-color: var(--signal);
    color: #0b0b0b;
  }

  .topics input:focus-visible + span {
    outline: 2px solid var(--signal);
    outline-offset: 2px;
  }

  .field {
    position: relative;
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 1.5rem 0 0.6rem;
    border: 0;
    border-bottom: 1px solid var(--line-2);
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 1.1rem;
    resize: vertical;
    transition: border-color 0.3s;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--signal);
  }

  .field label {
    position: absolute;
    left: 0;
    top: 1.5rem;
    color: var(--muted);
    pointer-events: none;
    transform-origin: left top;
    transition:
      transform 0.4s var(--ease-out),
      color 0.3s;
  }

  .field input:focus + label,
  .field input:not(:placeholder-shown) + label,
  .field textarea:focus + label,
  .field textarea:not(:placeholder-shown) + label {
    transform: translateY(-1.4rem) scale(0.72);
    color: var(--signal);
  }

  .field::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--signal);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease-out);
  }

  .field:focus-within::after {
    transform: scaleX(1);
  }

  .send {
    justify-self: start;
    margin-top: 0.5rem;
  }

  .sent {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1rem;
    padding: 2rem;
    background: var(--bg-2);
    text-align: center;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.6s var(--ease-out),
      visibility 0s 0.6s;
  }

  .form.is-sent .sent {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.6s var(--ease-out);
  }

  .sent svg {
    width: 10rem;
    fill: none;
    stroke: var(--signal);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 220;
    stroke-dashoffset: 220;
    filter: drop-shadow(0 0 8px rgba(255, 90, 31, 0.7));
  }

  .form.is-sent .sent svg {
    animation: draw 1.4s var(--ease-out) 0.2s forwards;
  }

  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }

  .sent-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    font-stretch: 80%;
    text-transform: uppercase;
    line-height: 1;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  const state = document.querySelector<HTMLElement>('[data-form-state]');
  const label = document.querySelector<HTMLElement>('[data-send-label]');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    // Thema in den Betreff übernehmen, damit es im Postfach sichtbar ist
    const thema = data.get('thema');
    if (thema) data.set('subject', `[${thema}] ${data.get('subject') ?? ''}`);

    form.classList.add('is-sending');
    if (state) state.textContent = 'Sende …';
    if (label) label.textContent = 'Wird gesendet …';

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(String(res.status));
      form.classList.remove('is-sending');
      form.classList.add('is-sent');
      if (state) state.textContent = 'Gesendet';
      form.reset();
    } catch {
      form.classList.remove('is-sending');
      if (state) state.textContent = 'Fehler';
      if (label) label.textContent = 'Erneut versuchen';
      alert(`Das hat leider nicht geklappt. Schreib mir gern direkt an youtube@tsojka.com.`);
    }
  });
</script>
