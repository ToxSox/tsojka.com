---
interface Props {
  ch: string;
  label: string;
  /** Zeilen der Überschrift; Text in *Sternchen* wird hervorgehoben. */
  lines: string[];
  as?: 'h1' | 'h2';
}
const { ch, label, lines, as: Tag = 'h2' } = Astro.props;
const toHtml = (s: string) => s.replace(/\*(.+?)\*/g, '<em>$1</em>');
---

<header class="chapter-head">
  <p class="chapter-tag mono" data-reveal>
    <span>CH.{ch}</span><span>/</span><span>{label}</span><span class="line"></span>
  </p>
  <Tag class="chapter-title" data-split aria-label={lines.join(' ').replace(/\*/g, '')}>
    {
      lines.map((l, i) => (
        <span class="split-line" aria-hidden="true">
          <span style={`--i:${i}`} set:html={toHtml(l)} />
        </span>
      ))
    }
  </Tag>
  {Astro.slots.has('default') && <div class="lede" data-reveal style="--d:2"><slot /></div>}
</header>
