---
import ChapterHead from './ChapterHead.astro';
import { site, videoFormats } from '../data/site';
import '../styles/videos.css';
---

<section class="chapter videos" id="videos">
  <div class="wrap">
    <ChapterHead ch="01" label="Videos & Tutorials" lines={['Car-HiFi', 'auf *YouTube*']}>
      <p>
        Auf meinem ständig wachsenden <a href={site.youtube} target="_blank" rel="noopener noreferrer">YouTube-Kanal</a> teile
        ich mein geballtes Wissen rund um <strong>Car-HiFi, Raumakustik und Elektrotechnik im KFZ</strong>. Egal, ob du
        Einsteiger bist oder als erfahrener Sound-Tüftler das letzte Quäntchen Klang aus deinem DSP holen willst – hier
        findest du hochwertige Inhalte.
      </p>
    </ChapterHead>

    <div class="vgrid" data-latest aria-live="polite">
      <div class="vskeleton" style="grid-column: 1 / -1; aspect-ratio: 21 / 9"></div>
      <div class="vskeleton"></div>
      <div class="vskeleton"></div>
      <div class="vskeleton"></div>
    </div>

    <div class="videos-actions" data-reveal>
      <a class="btn btn--solid" href="/videos" data-magnetic>
        Zum Video-Archiv <span class="mono" data-video-count></span><span class="arrow">→</span>
      </a>
      <a class="btn" href={site.youtube} target="_blank" rel="noopener noreferrer" data-magnetic>Kanal abonnieren ↗</a>
    </div>

    <div class="formats">
      <p class="mono muted formats-title" data-reveal>Beliebte Videoformate & Themen</p>
      <ol>
        {
          videoFormats.map((f, i) => (
            <li data-reveal style={`--d:${i}`}>
              <span class="mono signal">F.{String(i + 1).padStart(2, '0')}</span>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .videos-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .videos-actions .mono:empty {
    display: none;
  }

  .videos-actions .btn .mono {
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.15);
    font-size: 0.65rem;
  }

  .formats {
    margin-top: clamp(5rem, 10vw, 8rem);
  }

  .formats-title {
    margin-bottom: 1.5rem;
  }

  .formats ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 20px;
    overflow: hidden;
  }

  .formats li {
    display: grid;
    gap: 1rem;
    align-content: start;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--bg);
    transition: background 0.4s;
  }

  .formats li:hover {
    background: var(--bg-2);
  }

  .formats h3 {
    font-size: clamp(1.4rem, 2.2vw, 2rem);
    font-weight: 700;
    line-height: 1.05;
  }

  .formats p {
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .formats ol {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { loadVideos, videoCard } from '../scripts/videos';

  const grid = document.querySelector<HTMLElement>('[data-latest]');
  const count = document.querySelector<HTMLElement>('[data-video-count]');

  if (grid) {
    const io = new IntersectionObserver(
      async ([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        try {
          const videos = await loadVideos();
          grid.innerHTML = videos
            .slice(0, 7)
            .map((v, i) => videoCard(v, i, i === 0))
            .join('');
          if (count) count.textContent = String(videos.length);
        } catch {
          grid.innerHTML =
            '<p class="muted">Videos konnten gerade nicht geladen werden – schau direkt auf YouTube vorbei.</p>';
        }
      },
      { rootMargin: '600px 0px' },
    );
    io.observe(grid);
  }
</script>
