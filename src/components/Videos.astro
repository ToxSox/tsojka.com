---
import { intro, pillars, site, videoFormats } from '../data/site';
import '../styles/videos.css';
---

<!-- Akt 2 · Fülle. reveal: das neueste Video wird aufgedeckt (BRIEF.md §8). -->
<section id="videos" class="ground ground--graphite videos" data-sc-act="flow">
  <div class="sc-wrap">
    <header class="chapter-open chapter-open--center" data-sc-in data-sc-stagger="70">
      <h2 class="statement">Car-HiFi auf <em>YouTube.</em></h2>
      <p class="lead">{pillars.videos}</p>
    </header>

    <div class="featured" data-sc-reveal="up" data-sc-reveal-at="0.12 0.42">
      <div class="vgrid" data-featured aria-live="polite">
        <div class="vskeleton vskeleton--wide"></div>
      </div>
    </div>
  </div>
</section>

<section class="ground ground--graphite videos-more" aria-label="Mehr Videos">
  <div class="sc-wrap">
    <div class="hub" data-sc-in data-sc-stagger="70">
      <p class="hub-text">{intro.hub}</p>
      <div class="hub-side">
        <p class="body">
          Auf meinem ständig wachsenden <a href={site.youtube} target="_blank" rel="noopener noreferrer">YouTube-Kanal</a>{' '}
          teile ich mein geballtes Wissen rund um Car-HiFi, Raumakustik und Elektrotechnik im KFZ. Egal, ob du Einsteiger bist
          oder als erfahrener Sound-Tüftler das letzte Quäntchen Klang aus deinem DSP holen willst: Hier findest du hochwertige
          Inhalte.
        </p>
        <p class="body">{intro.journey}</p>
        <div class="hub-actions">
          <a class="pill" href="/videos">Alle <span data-video-count>Videos</span> im Archiv</a>
          <a class="more" href={site.youtube} target="_blank" rel="noopener noreferrer">Kanal abonnieren</a>
        </div>
      </div>
    </div>

    <h3 class="title latest-title" data-sc-in>Neu auf dem Kanal</h3>
    <div class="vgrid latest" data-latest aria-live="polite">
      {Array.from({ length: 3 }).map(() => <div class="vskeleton" />)}
    </div>

    <div class="formats">
      <h3 class="title" data-sc-in>Beliebte Videoformate und Themen</h3>
      <dl class="formats-list" data-sc-in data-sc-stagger="60">
        {
          videoFormats.map((f) => (
            <div>
              <dt>{f.title}</dt>
              <dd>{f.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .videos {
    padding-bottom: var(--sc-8);
  }

  .featured {
    margin-inline: auto;
    max-width: 68rem;
  }

  .featured :global(.vgrid) {
    grid-template-columns: 1fr;
  }

  .vskeleton--wide {
    aspect-ratio: 16 / 9;
  }

  .videos-more {
    padding-block: var(--sc-8) var(--sc-section);
  }

  .hub {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: var(--sc-7) var(--sc-9);
    align-items: start;
  }

  .hub-text {
    margin: 0;
    font-size: clamp(1.35rem, 1.05rem + 1.2vw, 2.1rem);
    font-weight: 600;
    line-height: 1.22;
    letter-spacing: -0.025em;
    text-wrap: pretty;
  }

  .hub-side > * + * {
    margin-top: var(--sc-4);
  }

  .hub-side a:not(.pill):not(.more) {
    color: var(--sc-ink);
  }

  .hub-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sc-5);
    padding-top: var(--sc-3);
  }

  .latest-title {
    margin-top: var(--sc-10);
    margin-bottom: var(--sc-5);
  }

  .latest {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .formats {
    margin-top: var(--sc-10);
  }

  .formats-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sc-6) var(--sc-8);
    margin: var(--sc-5) 0 0;
  }

  .formats-list > div {
    padding-top: var(--sc-4);
    border-top: 1px solid var(--sc-hairline);
  }

  .formats-list dt {
    font-weight: 600;
    font-size: var(--sc-t-lg);
    letter-spacing: -0.015em;
  }

  .formats-list dd {
    margin: var(--sc-2) 0 0;
    color: var(--sc-ink-soft);
  }

  @media (max-width: 960px) {
    .hub,
    .formats-list {
      grid-template-columns: 1fr;
    }

    .latest {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .latest {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { loadVideos, videoCard } from '../scripts/videos';

  const featured = document.querySelector<HTMLElement>('[data-featured]');
  const latest = document.querySelector<HTMLElement>('[data-latest]');
  const count = document.querySelector<HTMLElement>('[data-video-count]');

  // Sofort laden, damit die Seite nicht während eines Sprungs per Navigation wächst
  loadVideos()
    .then((videos) => {
      if (featured && videos[0]) featured.innerHTML = videoCard(videos[0], 0, true);
      if (latest) latest.innerHTML = videos.slice(1, 7).map((v, i) => videoCard(v, i)).join('');
      if (count) count.textContent = `${videos.length} Videos`;
    })
    .catch(() => {
      const msg = '<p class="body">Videos konnten gerade nicht geladen werden. Schau direkt auf YouTube vorbei.</p>';
      if (featured) featured.innerHTML = msg;
      if (latest) latest.innerHTML = '';
    });
</script>
