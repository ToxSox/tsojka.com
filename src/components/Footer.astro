---
import { chapters, site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="ftr ground ground--black">
  <div class="sc-wrap">
    <div class="ftr-cols">
      <div>
        <p class="ftr-claim">Aus der Community, <span class="accent">für die Community.</span></p>
      </div>
      <nav class="ftr-col" aria-label="Kapitel">
        <p class="label">Kapitel</p>
        {chapters.map((c) => <a href={`/#${c.id}`}>{c.label}</a>)}
      </nav>
      <nav class="ftr-col" aria-label="Mehr">
        <p class="label">Mehr</p>
        <a href="/videos">Video-Archiv</a>
        <a href={site.youtube} target="_blank" rel="noopener noreferrer">YouTube ↗</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
      </nav>
    </div>

    <a class="ftr-giant" href="/" aria-label="Zur Startseite">
      {'TSOJKA'.split('').map((c, i) => <span style={`--i:${i}`}>{c}</span>)}
    </a>

    <p class="ftr-bottom">© {year} {site.title} · {site.author}</p>
  </div>
</footer>

<style>
  .ftr {
    padding-top: var(--sc-9);
    border-top: 1px solid var(--sc-hairline);
  }

  .ftr-cols {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(2, minmax(0, 1fr));
    gap: var(--sc-7) var(--sc-6);
  }

  .ftr-claim {
    margin: 0;
    max-width: 18ch;
    font-size: var(--sc-t-xl);
    font-weight: 650;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .ftr-col {
    display: grid;
    gap: var(--sc-2);
    align-content: start;
    font-size: var(--sc-t-sm);
  }

  .ftr-col .label {
    margin-bottom: var(--sc-2);
  }

  .ftr-col a {
    color: var(--sc-ink-soft);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .ftr-col a:hover {
    color: var(--sc-ink);
    text-decoration: underline;
  }

  .ftr-giant {
    display: flex;
    justify-content: space-between;
    margin-top: var(--sc-9);
    font-size: clamp(4rem, 22vw, 20rem);
    font-weight: 750;
    line-height: 0.76;
    letter-spacing: -0.05em;
    color: #1c1c1f;
    text-decoration: none;
  }

  .ftr-giant span {
    display: inline-block;
    transition:
      color 0.5s var(--sc-ease-out),
      transform 0.6s var(--sc-ease-out);
    transition-delay: calc(var(--i) * 40ms);
  }

  @media (hover: hover) and (pointer: fine) {
    .ftr-giant:hover span {
      color: var(--sc-accent);
      transform: translateY(-5%);
    }
  }

  .ftr-bottom {
    margin: 0;
    padding-block: var(--sc-5) var(--sc-6);
    color: var(--sc-ink-soft);
    font-size: var(--sc-t-xs);
  }

  @media (max-width: 760px) {
    .ftr-cols {
      grid-template-columns: 1fr 1fr;
    }

    .ftr-cols > div:first-child {
      grid-column: 1 / -1;
    }
  }
</style>
