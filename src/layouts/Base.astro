---
import '../vendor/scrollcraft/scrollcraft.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cursor from '../components/Cursor.astro';
import profil from '../assets/profil.jpg';
import { getImage } from 'astro:assets';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
}

const { title, description = site.description, home = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.title}` : `${site.title} · Car-HiFi, DSP-Tuning & Messtechnik`;
const og = await getImage({ src: profil, width: 800, format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site).href;
---

<!doctype html>
<html lang="de" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={site.title} />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class:list={[home && 'is-home']}>
    <a class="skip" href="#main">Zum Inhalt springen</a>
    <div class="sc-grain" aria-hidden="true"></div>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <a class="to-top" href="#main" data-to-top aria-label="Nach oben" tabindex="-1">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
    </a>
    <Cursor />
    <!-- scrollcraft-Engine, unverändert aus dem Skill (MIT, siehe /scrollcraft/LICENSE) -->
    <script is:inline src="/scrollcraft/scrollcraft.js"></script>
    <script>
      import '../scripts/core';
    </script>
  </body>
</html>

<style>
  .skip {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 10000;
    padding: 0.6rem 1rem;
    border-radius: var(--sc-r-pill);
    background: var(--sc-accent);
    color: var(--sc-accent-ink);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-200%);
  }

  .skip:focus {
    transform: none;
  }

  .to-top {
    position: fixed;
    right: 1rem;
    bottom: calc(1rem + env(safe-area-inset-bottom));
    z-index: 80;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: rgba(29, 29, 31, 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #f5f5f7;
    box-shadow: var(--sc-e2);
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition:
      opacity 0.24s var(--sc-ease-out),
      transform 0.24s var(--sc-ease-out),
      visibility 0s 0.24s;
  }

  .to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.24s var(--sc-ease-out),
      transform 0.24s var(--sc-ease-out);
  }

  .to-top svg {
    width: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
